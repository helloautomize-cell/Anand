# Canonical host override (defaults to site.json siteUrl)
NEXT_PUBLIC_SITE_URL=https://www.anandheartcenter.com

# GA4 measurement ID — analytics loads only after cookie consent.
# Leave unset to disable analytics entirely. [CONFIRM: GA4 property]
NEXT_PUBLIC_GA_ID=

# Set on preview deployments only: force noindex off for testing.
# Production (VERCEL_ENV=production) indexes automatically.
NEXT_PUBLIC_ALLOW_INDEXING=

# IndexNow manual submission auth + cron secret for /api/indexnow.
CRON_SECRET=
