{
  "name": "anand-heart-center",
  "version": "1.0.0",
  "private": true,
  "description": "Anand Heart Center Bhopal website",
  "browserslist": [
    "chrome >= 95",
    "edge >= 95",
    "firefox >= 95",
    "safari >= 15.5",
    "ios_saf >= 15.5",
    "android >= 95"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "images": "node scripts/process-images.mjs",
    "launch-check": "node scripts/launch-check.mjs",
    "seo:check": "node scripts/prelaunch-check.mjs && node scripts/validate-schema.mjs && node scripts/crawl-text-check.mjs",
    "prebuild": "node scripts/gen-md-mirrors.mjs",
    "md:mirrors": "node scripts/gen-md-mirrors.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "gray-matter": "^4.0.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "schema-dts": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cheerio": "^1.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.8.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
